NODE_ENV=development
APP_ENV=dev
HOST=127.0.0.1
PORT=8083
SERVICE_KEY_API_CORE=
SERVICE_KEY_API_AUTH=
DOCS_ENABLED=true
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
EMAIL_FROM=noreply@solaria.local
EMAIL_ALLOWED_ORIGINS=http://localhost:5173
EMAIL_TRANSPORT=smtp
# For Brevo HTTPS (QA/prod), use EMAIL_TRANSPORT=brevo and set the API key.
BREVO_API_KEY=
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Alertas do Grafana
SERVICE_KEY_GRAFANA=
SERVICE_KEY_WORKER_ALERTS=
# So alertas deste ambiente geram ticket, e-mail e WhatsApp.
ALERT_ENVIRONMENT=prod
# URL publica do Grafana (HTTPS fora do dev): base dos links de dashboard, logs e traces.
ALERT_GRAFANA_URL=
# Destinatarios do e-mail de alerta, separados por ; (ficam aqui, nunca no payload do Grafana).
ALERT_EMAIL_TO=
# Intervalo minimo entre tickets do mesmo alerta, teto em 24 h e janela de logs do aviso (minutos).
ALERT_MIN_INTERVAL_MIN=30
ALERT_MAX_PER_24H=8
ALERT_LOG_WINDOW_MIN=30
# Jira
JIRA_BASE_URL=
JIRA_USER=
JIRA_API_TOKEN=
JIRA_PROJECT=INC
JIRA_ISSUE_TYPE=Incidente
JIRA_FIELD_START=
JIRA_FIELD_END=
# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
WHATSAPP_API_VERSION=v23.0
WHATSAPP_ALERT_TO=
